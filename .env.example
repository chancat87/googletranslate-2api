# ====================================================================
# googletranslate-2api 配置文件模板 (v2.13.5)
# ====================================================================
# 请将此文件重命名为 ".env" 并填入您的凭证。
# 所有可选配置均提供默认值, 无需全部填写。

# --- 核心安全配置 (必须设置) ---
# 用于保护您 API 服务的访问密钥; 支持逗号分隔多 key (如 "k1,k2")。
# 设为 "1" 或留空则关闭认证 (仅本地调试建议)。
# 启动时若 key 缺失/过弱(<16字符)/为示例默认值, 会在日志发出 WARNING 告警。
API_MASTER_KEY=sk-googletranslate-2api-default-key-please-change-me

# --- 部署配置 (可选) ---
# Nginx 对外暴露的端口
NGINX_PORT=8088

# --- 上游请求超时 (可选, 秒) ---
API_REQUEST_TIMEOUT=60
# --- 上游基址 (可选, 压测/本地 mock 用; 默认 Google translate-pa) ---
# UPSTREAM_BASE_URL=https://translate-pa.googleapis.com

# --- 按 Key 用量与配额 (v2.1.0, 默认关) ---
# USAGE_STORE_ENABLED=false
# USAGE_DB_PATH=data/usage.db
# USAGE_DAY_QUOTA=0   # 每个上游 Key 每日请求上限, 0=不限

# --- 默认模型名 / 模型别名 (可选) ---
DEFAULT_MODEL=google-translate
# MODEL_ALIASES={"gpt-3.5-turbo": "google-translate"}

# --- Google Translate 凭证 (必须设置) ---
# 没有 Key 想先体验时, 可设 DEMO_MODE=true (返回 demo: 前缀, 不访问真实上游)
# DEMO_MODE=false
# 请从浏览器开发者工具的网络请求中找到 `translateHtml` 请求,
# 并复制其请求头中的 `x-goog-api-key` 值 (注意不要带引号)。
GOOGLE_API_KEY="在这里填入你的谷歌翻译 API Key"

# --- 多上游 Key 池 (阶段 1.1, 可选) ---
# 逗号分隔多个 x-goog-api-key, 403/429/网络错误时自动切换到下一个 Key (全部耗尽才失败)。
# 未设置时回退 GOOGLE_API_KEY (向后兼容)。
# GOOGLE_API_KEYS="key1,key2,key3"
# 也可以从本地文件批量加载 (每行一个, # 开头为注释), 启动时自动并入 Key 池:
# GOOGLE_API_KEYS_FILE=/absolute/path/to/keys.txt
# Key 失败后的冷却秒数: 到期前不再优先选它 (0 = 立即重试)
# KEY_FAILOVER_COOLDOWN_SECONDS=60

# --- 链路摘要 (阶段 1.2, 可选) ---
# 进程内环形缓冲上限: 非流式返回 X-Trace-Summary 头, 流式返回 X-Trace-Id,
# 均可通过 GET /v1/traces/{request_id} 查询 (只含元数据, 不含原文/明文 Key)。
# TRACE_STORE_MAXLEN=512
# --- 链路摘要后端 (v1.7.0: memory | redis; redis 故障回退内存) ---
# TRACE_BACKEND=memory
# TRACE_PREFIX=g2api:trace:
# TRACE_TTL=3600

# --- 流式分段 (可选, 默认关) ---
# STREAM_CHUNK_ENABLED=false
# STREAM_CHUNK_THRESHOLD=500
# STREAM_CHUNK_MAX=500
# --- SSE 心跳 (v1.7.0, 秒; 0=关闭) ---
# SSE_HEARTBEAT_INTERVAL=0

# --- 缓存 (可选) ---
# CACHE_ENABLED=true
# CACHE_MAXSIZE=1000
# CACHE_TTL=3600
# --- Redis 共享缓存 (v1.6.0, 多 worker/多副本共用一份缓存) ---
# CACHE_BACKEND=memory        # memory | redis; redis 不可用时自动回退内存
# REDIS_URL=redis://127.0.0.1:6379/0
# CACHE_PREFIX=g2api:

# --- 输入长度上限 (可选, 字符) ---
# MAX_TEXT_LENGTH=5000

# --- 就绪探针文本 (可选) ---
# READY_PROBE_TEXT=hi

# --- 批量翻译 (可选) ---
# BATCH_MAX_CONCURRENCY=10

# --- HTTPX 连接池 (v1.5.1, 0=自动=max(10, BATCH_MAX_CONCURRENCY+5) / max(5, BATCH_MAX_CONCURRENCY)) ---
# HTTPX_MAX_CONNECTIONS=0
# HTTPX_MAX_KEEPALIVE_CONNECTIONS=0
# BATCH_MAX_ITEMS=50
# BATCH_DEADLINE_SECONDS=120

# --- 日志格式 (可选: text | json) ---
# LOG_FORMAT=text
# --- 日志级别 (可选: DEBUG | INFO | WARNING | ERROR); 高并发/生产建议 WARNING 降低每请求开销 ---
# LOG_LEVEL=INFO

# --- 上游重试 (可选) ---
# UPSTREAM_RETRY_ATTEMPTS=3
# UPSTREAM_RETRY_BACKOFF_BASE=0.5
# UPSTREAM_RETRY_MAX_BACKOFF=3.0
# UPSTREAM_RETRY_JITTER=0.3

# --- 熔断器 (可选) ---
# CIRCUIT_BREAKER_ENABLED=true
# CIRCUIT_FAILURE_THRESHOLD=10
# CIRCUIT_WINDOW_SECONDS=60
# CIRCUIT_OPEN_SECONDS=30

# --- 限流 (可选, 默认关; 多副本请配合网关层) ---
# RATE_LIMIT_ENABLED=false
# RATE_LIMIT_CAPACITY=30
# RATE_LIMIT_PER_SECOND=10.0
# RATE_LIMIT_MAX_KEYS=10000
# TRUST_PROXY_HEADER=false   # 可信反代后置 true, 按 X-Forwarded-For 取真实客户端 IP 限流
# ALLOW_WEAK_API_KEY=false   # true 时放行公开示例/弱主密钥 (不推荐)
# --- 限流后端 (v1.7.0: memory | redis; redis 故障回退内存) ---
# RATE_LIMIT_BACKEND=memory
# RATE_LIMIT_REDIS_URL=     # 留空复用 REDIS_URL
# RATE_LIMIT_PREFIX=g2api:rl:
# RATE_LIMIT_TTL=3600

# --- Prometheus 指标 (可选) ---
# METRICS_ENABLED=true

# --- 代理池 (v2.13.0, 可选; 解决上游按 IP 高并发风控) ---
# 总开关: true 时启用代理轮换; 无代理可用时自动回退直连
# PROXY_ENABLED=false
# 住宅代理文件: 每行一个, 支持 host:port / user:pass@host:port / http(s)://...
# PROXY_FILE=data/proxies.txt
# 后台抓取免费代理并校验注入 (true 开启)
# PROXY_FREE_FETCH=false
# 抓取/校验周期 (秒)
# PROXY_FREE_REFRESH_SECONDS=600
# 逗号分隔免费代理列表 URL, 留空用内置默认源
# PROXY_FREE_URLS=
# 每代理每日最大使用次数 (0=不限)
# PROXY_MAX_USE_PER_DAY=200
# 递增冷却秒数 (第1..N次使用后), 逗号分隔
# PROXY_USE_COOLDOWN_MAP=0,10,30,90,300
# 同一 Key 失败后最多换多少个代理再切 Key
# PROXY_MAX_ATTEMPTS=3
# 代理健康校验目标 (短超时, 不消耗翻译配额)
# PROXY_VALIDATE_URL=https://www.gstatic.com/generate_204
# PROXY_VALIDATE_TIMEOUT=5.0
# 免费代理校验并发/样本/节奏 (分批校验, 避免 1 核机器启动被拖垮)
# PROXY_VALIDATE_CONCURRENCY=10
# PROXY_VALIDATE_SAMPLE=200
# PROXY_VALIDATE_PACE=0.02
# 优先使用已校验通过的代理 (未校验代理仅在校验池为空时兜底)
# PROXY_PREFER_VALIDATED=true
# 走代理的上游连接超时 (秒)
# PROXY_CONNECT_TIMEOUT=8.0
# 走代理的上游整体请求超时 (秒); 免费代理慢, 设短值快速换下一个
# PROXY_REQUEST_TIMEOUT=10.0
# 代理请求并发上限 (0=不限); 保护上游与代理源
# PROXY_MAX_INFLIGHT=50
