# ====================================================================
# googletranslate-2api 配置文件模板 (v1.5.0)
# ====================================================================
# 请将此文件重命名为 ".env" 并填入您的凭证。
# 所有可选配置均提供默认值, 无需全部填写。

# --- 核心安全配置 (必须设置) ---
# 用于保护您 API 服务的访问密钥; 支持逗号分隔多 key (如 "k1,k2")。
# 设为 "1" 或留空则关闭认证 (仅本地调试建议)。
# 启动时若 key 缺失/过弱(<16字符)/为示例默认值, 会在日志发出 WARNING 告警。
API_MASTER_KEY=sk-googletranslate-2api-default-key-please-change-me

# --- 部署配置 (可选) ---
# Nginx 对外暴露的端口
NGINX_PORT=8088

# --- 上游请求超时 (可选, 秒) ---
API_REQUEST_TIMEOUT=60

# --- 默认模型名 / 模型别名 (可选) ---
DEFAULT_MODEL=google-translate
# MODEL_ALIASES={"gpt-3.5-turbo": "google-translate"}

# --- Google Translate 凭证 (必须设置) ---
# 请从浏览器开发者工具的网络请求中找到 `translateHtml` 请求,
# 并复制其请求头中的 `x-goog-api-key` 值 (注意不要带引号)。
GOOGLE_API_KEY="在这里填入你的谷歌翻译 API Key"

# --- 多上游 Key 池 (阶段 1.1, 可选) ---
# 逗号分隔多个 x-goog-api-key, 403/429/网络错误时自动切换到下一个 Key (全部耗尽才失败)。
# 未设置时回退 GOOGLE_API_KEY (向后兼容)。
# GOOGLE_API_KEYS="key1,key2,key3"
# Key 失败后的冷却秒数: 到期前不再优先选它 (0 = 立即重试)
# KEY_FAILOVER_COOLDOWN_SECONDS=60

# --- 链路摘要 (阶段 1.2, 可选) ---
# 进程内环形缓冲上限: 非流式返回 X-Trace-Summary 头, 流式返回 X-Trace-Id,
# 均可通过 GET /v1/traces/{request_id} 查询 (只含元数据, 不含原文/明文 Key)。
# TRACE_STORE_MAXLEN=512

# --- 流式分段 (可选, 默认关) ---
# STREAM_CHUNK_ENABLED=false
# STREAM_CHUNK_THRESHOLD=500
# STREAM_CHUNK_MAX=500

# --- 缓存 (可选) ---
# CACHE_ENABLED=true
# CACHE_MAXSIZE=1000
# CACHE_TTL=3600

# --- 输入长度上限 (可选, 字符) ---
# MAX_TEXT_LENGTH=5000

# --- 就绪探针文本 (可选) ---
# READY_PROBE_TEXT=hi

# --- 批量翻译 (可选) ---
# BATCH_MAX_CONCURRENCY=10
# BATCH_MAX_ITEMS=50
# BATCH_DEADLINE_SECONDS=120

# --- 日志格式 (可选: text | json) ---
# LOG_FORMAT=text

# --- 上游重试 (可选) ---
# UPSTREAM_RETRY_ATTEMPTS=3
# UPSTREAM_RETRY_BACKOFF_BASE=0.5
# UPSTREAM_RETRY_MAX_BACKOFF=3.0
# UPSTREAM_RETRY_JITTER=0.3

# --- 熔断器 (可选) ---
# CIRCUIT_BREAKER_ENABLED=true
# CIRCUIT_FAILURE_THRESHOLD=10
# CIRCUIT_WINDOW_SECONDS=60
# CIRCUIT_OPEN_SECONDS=30

# --- 限流 (可选, 默认关; 多副本请配合网关层) ---
# RATE_LIMIT_ENABLED=false
# RATE_LIMIT_CAPACITY=30
# RATE_LIMIT_PER_SECOND=10.0
# RATE_LIMIT_MAX_KEYS=10000
# TRUST_PROXY_HEADER=false   # 可信反代后置 true, 按 X-Forwarded-For 取真实客户端 IP 限流
# ALLOW_WEAK_API_KEY=false   # true 时放行公开示例/弱主密钥 (不推荐)

# --- Prometheus 指标 (可选) ---
# METRICS_ENABLED=true
